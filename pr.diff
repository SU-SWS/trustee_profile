diff --git a/themes/jemison/jemison.theme b/themes/jemison/jemison.theme
new file mode 100644
index 00000000..131b4884
--- /dev/null
+++ b/themes/jemison/jemison.theme
@@ -0,0 +1,17 @@
+<?php
+
+declare(strict_types=1);
+
+/**
+ * Implements hook_library_info_alter().
+ */
+function jemison_library_info_alter(&$libraries, $extension) {
+  // Keep libraries that are part of this theme.
+  if (\Drupal::service('theme_handler')->themeExists($extension)) {
+    return;
+  }
+  // Exclude libraries that are part of Stanford modules.
+  if (preg_match('/(stanford_|jumpstart|react|ui_pattern)/', $extension)) {
+    $libraries = [];
+  }
+}

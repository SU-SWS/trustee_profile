+++ b/themes/jemison/templates/field/cshs-term-group--su-opp-tags.html.twig
@@ -0,0 +1,30 @@
+{#
+/**
+ * @file
+ * Theme for "Group by root" formatter.
+ *
+ * Available variables:
+ * - id: The ID of a root term.
+ * - title: Title of a group.
+ * - terms: Children terms.
+ *
+ * @see cshs_theme()
+ *
+ * @ingroup themeable
+ */
+#}
+<div class="cshs-term-group">
+  <h2 class="cshs-term-group__title" data-id="{{ id }}">
+    {{ title }}
+  </h2>
+
+  {% if terms is not empty %}
+    <ul class="cshs-term-group__terms">
+      {% for term in terms %}
+        <li class="cshs-term-group__term" data-id="{{ term.id }}" data-parent="{{ term.parent }}">
+          {{ term.label }}{{ not loop.last ? ', ' }}
+        </li>
+      {% endfor %}
+    </ul>
+  {% endif %}
+</div>
